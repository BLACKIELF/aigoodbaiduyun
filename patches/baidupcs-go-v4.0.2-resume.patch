--- /dev/null
+++ b/requester/uploader/aigoodbaiduyun_resume_test.go
@@ -0,0 +1,43 @@
+package uploader
+
+import (
+	"context"
+	"github.com/qjfoidnh/BaiduPCS-Go/baidupcs/pcserror"
+	"github.com/qjfoidnh/BaiduPCS-Go/requester/rio"
+	"github.com/qjfoidnh/BaiduPCS-Go/requester/transfer"
+	"testing"
+)
+
+type resumeProbe struct {
+	calls  []int
+	merged map[int]string
+}
+
+func (p *resumeProbe) Precreate() (string, pcserror.Error) { return "", nil }
+func (p *resumeProbe) TmpFile(_ context.Context, _, _ string, id int, _ int64, _ rio.ReaderLen64) (string, error) {
+	p.calls = append(p.calls, id)
+	return "new", nil
+}
+func (p *resumeProbe) CreateSuperFile(_, _, _ string, _ int64, checksums map[int]string) error {
+	p.merged = checksums
+	return nil
+}
+func TestAigoodbaiduyunResumesOnlyMissingBlocks(t *testing.T) {
+	t.Setenv("AIGOODBAIDUYUN_RESUME", "1")
+	probe := &resumeProbe{}
+	u := NewMultiUploader(probe, rio.NewCryptoRandReaderAtLen64(8), &MultiUploaderConfig{Parallel: 1, BlockSize: 4}, "/test")
+	u.SetInstanceState(&InstanceState{Uploadid: "test-session", BlockList: []*BlockState{
+		{ID: 0, Range: transfer.Range{Begin: 0, End: 4}, CheckSum: "saved"},
+		{ID: 1, Range: transfer.Range{Begin: 4, End: 8}},
+	}})
+	success := false
+	u.OnSuccess(func() { success = true })
+	u.OnError(func(err error) { t.Fatal(err) })
+	u.Execute()
+	if !success || len(probe.calls) != 1 || probe.calls[0] != 1 {
+		t.Fatalf("wrong resumed requests: %v", probe.calls)
+	}
+	if probe.merged[0] != "saved" || probe.merged[1] != "new" {
+		t.Fatalf("lost completed checksums: %v", probe.merged)
+	}
+}
